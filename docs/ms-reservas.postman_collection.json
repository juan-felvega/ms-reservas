{
  "info": {
    "name": "ms-reservas",
    "description": "Colección manual de ms-reservas (Evaluación Módulo 3), sin scripts. Requiere ms-usuarios en 3001 y ms-reservas en 3011 con la misma JWT_SECRET. Antes de correr: escribir el password en 00a y 00b solo en Postman (no se sube al repositorio), y copiar el token de cada respuesta a las variables token (administrador) y token_otro_rol. El 06 crea la reserva 4 con la base recién cargada (schema.sql); el 14 y el 15 la eliminan. Para repetir la colección, recargar la base.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 · Preparación (ms-usuarios)",
      "item": [
        {
          "name": "00a - Login administrador → 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{usuarios}}/usuarios/login",
              "host": [
                "{{usuarios}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@empresa.com\",\n  \"password\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "00b - Login usuario de otro rol → 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{usuarios}}/usuarios/login",
              "host": [
                "{{usuarios}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"medico@medired.com\",\n  \"password\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "01 - Listar todas → 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/reservas",
          "host": [
            "{{base}}"
          ],
          "path": [
            "reservas"
          ]
        }
      }
    },
    {
      "name": "02 - Filtrar por huesped → 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/reservas?huesped=Ana Torres",
          "host": [
            "{{base}}"
          ],
          "path": [
            "reservas"
          ],
          "query": [
            {
              "key": "huesped",
              "value": "Ana Torres"
            }
          ]
        }
      }
    },
    {
