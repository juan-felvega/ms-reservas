# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto y dirección donde escucha el microservicio.
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
PORT=3011
HOST=127.0.0.1

# Base de datos MySQL del microservicio (en el PC: localhost; en servidor2: la IP de servidor1)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reservas_db
DB_USER=reservas_user
DB_PASSWORD=cambie-esta-clave

# Clave con la que se verifican los tokens JWT.
# DEBE SER LA MISMA que en ms-usuarios.
JWT_SECRET=coloque-aqui-la-misma-clave-de-ms-usuarios
